# Install as /etc/testproject/api.env (chmod 600, owned by root). Read by deploy/systemd/app.service.

# Keep the app on loopback; only nginx should reach it.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

DB_URL=jdbc:postgresql://127.0.0.1:5432/app
DB_USER=app
DB_PASSWORD=change-me

# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me

# Origin of the SPA (no trailing slash). Must share a registrable domain with the API host.
CORS_ALLOWED_ORIGIN=https://app.example.com
COOKIE_SECURE=true

# First user, created only while the users table is empty. Remove both lines after the first start.
APP_BOOTSTRAP_USERNAME=admin
APP_BOOTSTRAP_PASSWORD=change-me-too
