# Install as /etc/testproject/api.env on the VPS (chmod 600, owned by root).
# deploy/.env is a symlink to it; deploy/compose.yaml reads every value from there.
# Use letters and digits for passwords: some symbols (like $) get mangled in this file.

# Database password. Generate with: openssl rand -hex 24
DB_PASSWORD=change-me

# At least 32 bytes. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Origin of the SPA (no trailing slash). Must share a registrable domain with the API host.
CORS_ALLOWED_ORIGIN=https://app.example.com
COOKIE_SECURE=true

# First user, created only while the users table is empty. Remove both lines after the first start.
APP_BOOTSTRAP_USERNAME=admin
APP_BOOTSTRAP_PASSWORD=change-me-too

# Optional: run a specific version instead of the newest, for example to roll back.
# The tags are listed on GitHub (your profile > Packages > testproject-backend), like sha-1a2b3c4.
# IMAGE_TAG=sha-1a2b3c4
